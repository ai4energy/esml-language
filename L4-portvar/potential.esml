<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 端口变量元素形 `<potential>`：元素名即角色，等价 `role="potential"`。
     连接节点上的 potential 相等照常生效。
     本例只展示 `<potential>` 这一语法点（i 用已覆盖的 portVariable 角色形声明）：
     10 V 源 — 2 Ω 电阻 — 地，解出 v = 10 / 0。
     `check` errors=0；`solve`（system S）：r.a.v = 10.0、r.b.v = 0.0。 -->
 <esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L4_PotentialElement">
   <variableTypes><type name="real" unit="1" default="0.0" role="algebraic"/></variableTypes>
   <portTypes><portType name="Pin" connectorFamily="electrical">
     <variables>
       <portVariable name="i" role="flow" type="real"/>
     </variables>
     <potential name="v" type="real"/>
   </portType></portTypes>
   <modelTypes>
     <modelType name="Src">
       <ports><port name="p" portType="Pin"/></ports>
       <parameters><parameter name="V" type="real" default="10.0"/></parameters>
       <variables>
         <variable name="p.v" type="real" role="algebraic"/>
         <variable name="p.i" type="real" role="algebraic"/>
       </variables>
       <equations><equation>p.v = V</equation></equations>
     </modelType>
     <modelType name="R">
       <ports><port name="a" portType="Pin"/><port name="b" portType="Pin"/></ports>
       <parameters><parameter name="R" type="real" default="2.0"/></parameters>
       <variables>
         <variable name="a.v" type="real" role="algebraic"/>
         <variable name="a.i" type="real" role="algebraic"/>
         <variable name="b.v" type="real" role="algebraic"/>
         <variable name="b.i" type="real" role="algebraic"/>
       </variables>
       <equations>
         <equation>a.v - b.v = R * a.i</equation>
         <equation>a.i + b.i = 0.0</equation>
       </equations>
     </modelType>
     <modelType name="Gnd">
       <ports><port name="g" portType="Pin"/></ports>
       <variables>
         <variable name="g.v" type="real" role="algebraic"/>
         <variable name="g.i" type="real" role="algebraic"/>
       </variables>
       <equations><equation>g.v = 0</equation></equations>
     </modelType>
   </modelTypes>
   <systems><system name="S" discipline="electrical">
     <instances>
       <instance name="s" type="Src"/>
       <instance name="r" type="R"/>
       <instance name="g" type="Gnd"/>
     </instances>
     <connections>
       <connection from="s.p" to="r.a"/>
       <connection from="r.b" to="g.g"/>
     </connections>
     <schedule><sequence><continueFor time="1"/></sequence></schedule>
   </system></systems>
 </esml>
