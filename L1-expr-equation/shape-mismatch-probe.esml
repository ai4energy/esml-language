<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 负例（预期失败）：`v + M`，v 为 rank-1 [3]，M 为 rank-2 [3, 2]，形状不一致。
     唯一合法的广播是 scalar × array；其余形状不一致一律报错，不做隐式自动广播。
     非零退出是预期行为；配套正例见 `axis-reduce.esml`。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L1_ShapeMismatchProbe">
  <variableTypes><type name="real" unit="1" default="0.0" role="algebraic"/></variableTypes>
  <modelTypes>
    <modelType name="M" discipline="generic">
      <variables>
        <variable name="v" type="real" array="3" initial="0.0" role="algebraic"/>
        <variable name="M" type="real" array="3,2" initial="0.0" role="algebraic"/>
        <variable name="r" type="real" initial="0.0" role="algebraic"/>
      </variables>
      <equations>
        <equation>r = v + M</equation>
      </equations>
    </modelType>
  </modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="M"/></instances>
    <schedule><sequence><continueFor time="0"/></sequence></schedule>
  </system></systems>
</esml>
