<!-- 语法点 方程级 <for var="k" in="Species"> 按序集迭代：k 绑成员序位（1起），
     非 label 字符串；body 里 C(k) 展开为 C_1,C_2,C_3（元素名由 array="Species"
     展开时按序位生成）；<body> 包裹与不包裹等价（同解）。可核数：S=sum(C[1:3])=6。
     规范条文：附录 B（续）— FOR 按序集迭代。
     check errors=0；solve（system S）：C_1=1 C_2=2 C_3=3 S=6。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L1_ForOverOrderedSet">
  <orderedSet name="Species" static="true">
    <element>H2O</element><element>CO2</element><element>CH4</element>
  </orderedSet>
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes><modelType name="M">
    <variables>
      <variable name="C" type="real" role="algebraic" array="Species"/>
      <variable name="S" type="real" role="algebraic"/>
    </variables>
    <equations>
      <for var="k" in="Species">
        <body><equation>C(k) = 1.0 * k</equation></body>
      </for>
      <equation>S = sum(C[1:3])</equation>
    </equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="M"/></instances>
    <schedule><sequence><continueFor time="0"/></sequence></schedule>
  </system></systems>
</esml>
