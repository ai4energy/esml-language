<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 负例：`<partial wrt="x">`，函数 `<derivative mode="analytic">` 内声明对 x 的偏导。
     `<body>` 与 `<derivative>` 互斥；本件同时给出 `<body>` 与偏导声明，
     因此 **canonical schema 校验应报错**（`xsd/esml-canonical-basic.xsd` 里
     `<body>` 与 `<derivative>` 同属 `xs:choice maxOccurs=1`，二者互斥）。⚠ 实现侧的 `check`
     目前**仍放行**（未实现这条互斥）—— 属规范↔实现缺口，见 `docs/coverage.md`。
     本件只演示该 token 的拼写，不是可运行样例。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L1_Partial">
  <variableTypes><type name="real" unit="1" default="0.0" role="algebraic"/></variableTypes>
  <functions><function name="sq">
    <inputs><input name="x"/></inputs>
    <outputs><output name="y"/></outputs>
    <body>y = x * x</body>
    <derivative mode="analytic"><partial wrt="x">2.0 * x</partial></derivative>
  </function></functions>
  <modelTypes><modelType name="M">
    <parameters><parameter name="x" type="real" default="3.0"/></parameters>
    <variables><variable name="y" type="real" role="algebraic"/></variables>
    <equations><equation>y = sq(x)</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="M"/></instances>
    <schedule><sequence><continueFor time="0"/></sequence></schedule>
  </system></systems>
</esml>
