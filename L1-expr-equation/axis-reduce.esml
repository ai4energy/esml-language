<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 数组归约沿指定维：`sum/prod/min/max(x, k)` 的第二参数 k 为字面整数时，
     校验 `0 ≤ k < rank(x)`，结果降一维。
       · sum(x, 0)  1D → 标量
       · sum(M, 1) / prod(M, 0) / min(M, 0) / max(M, 1)  2D → 1D
       · scalar × array 是唯一合法广播 ⇒ 结果同形
     本件仅演示 check 层 axis 范围校验（I25b），errors=0；
     SPEC 附录 F8 明文「不支持：多维数组归约」⇒ 多维归约是 spec backlog，
     不宣称可 solve（solve 会因 flatten 层 undeclared symbol 失败，属预期行为）。
     规范条文：§7（向量归约内建）＋ 附录 F8（vector 归约内建；多维归约 backlog）。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L1_AxisReduce">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes>
    <!-- 1D + axis=0 ⇒ 标量 -->
    <modelType name="M1DAxis0" discipline="generic">
      <variables>
        <variable name="x" type="real" array="3" role="algebraic"/>
        <variable name="s" type="real" role="algebraic"/>
      </variables>
      <equations>
        <equation>x[1] = 1.0</equation>
        <equation>x[2] = 2.0</equation>
        <equation>x[3] = 3.0</equation>
        <equation>s = sum(x, 0)</equation>
      </equations>
    </modelType>
    <!-- 2D + axis=1 ⇒ 1D array (3,) -->
    <modelType name="M2DAxis1" discipline="generic">
      <variables>
        <variable name="M" type="real" array="3,2" role="algebraic"/>
        <variable name="r" type="real" array="3" role="algebraic"/>
      </variables>
      <equations>
        <equation>M[1,1] = 1.0</equation><equation>M[1,2] = 2.0</equation>
        <equation>M[2,1] = 3.0</equation><equation>M[2,2] = 4.0</equation>
        <equation>M[3,1] = 5.0</equation><equation>M[3,2] = 6.0</equation>
        <equation>r = sum(M, 1)</equation>
      </equations>
    </modelType>
    <!-- 2D + axis=0 ⇒ 1D array (2,) with prod -->
    <modelType name="M2DProdAxis0" discipline="generic">
      <variables>
        <variable name="M" type="real" array="3,2" role="algebraic"/>
        <variable name="r" type="real" array="2" role="algebraic"/>
      </variables>
      <equations>
        <equation>M[1,1] = 1.0</equation><equation>M[1,2] = 2.0</equation>
        <equation>M[2,1] = 3.0</equation><equation>M[2,2] = 4.0</equation>
        <equation>M[3,1] = 5.0</equation><equation>M[3,2] = 6.0</equation>
        <equation>r = prod(M, 0)</equation>
      </equations>
    </modelType>
    <!-- 2D + min/max + 广播 (scalar × array 合法) -->
    <modelType name="M2DMinMaxBroadcast" discipline="generic">
      <variables>
        <variable name="M" type="real" array="3,2" role="algebraic"/>
        <variable name="mn" type="real" array="3" role="algebraic"/>
        <variable name="mx" type="real" array="2" role="algebraic"/>
        <variable name="s" type="real" role="algebraic"/>
        <variable name="v" type="real" array="3" role="algebraic"/>
      </variables>
      <equations>
        <equation>M[1,1] = 1.0</equation><equation>M[1,2] = 2.0</equation>
        <equation>M[2,1] = 3.0</equation><equation>M[2,2] = 4.0</equation>
        <equation>M[3,1] = 5.0</equation><equation>M[3,2] = 6.0</equation>
        <equation>mn = min(M, 0)</equation>
        <equation>mx = max(M, 1)</equation>
        <equation>s = 2.0</equation>
        <equation>v = M[1, 1] + s</equation>
      </equations>
    </modelType>
    <!-- 1D 索引 in-range -->
    <modelType name="M1DIndex" discipline="generic">
      <variables>
        <variable name="x" type="real" array="3" role="algebraic"/>
        <variable name="s" type="real" role="algebraic"/>
      </variables>
      <equations>
        <equation>x[1] = 1.0</equation>
        <equation>x[2] = 2.0</equation>
        <equation>x[3] = 3.0</equation>
        <equation>s = x[2]</equation>
      </equations>
    </modelType>
  </modelTypes>
  <systems>
    <system name="S1DAxis0">
      <instances><instance name="m" type="M1DAxis0"/></instances>
    </system>
    <system name="S2DAxis1">
      <instances><instance name="m" type="M2DAxis1"/></instances>
    </system>
    <system name="S2DProdAxis0">
      <instances><instance name="m" type="M2DProdAxis0"/></instances>
    </system>
    <system name="S2DMinMaxBroadcast">
      <instances><instance name="m" type="M2DMinMaxBroadcast"/></instances>
    </system>
    <system name="S1DIndex">
      <instances><instance name="m" type="M1DIndex"/></instances>
    </system>
  </systems>
</esml>
