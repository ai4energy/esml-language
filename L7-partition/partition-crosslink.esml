<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 分区（DDM）：`<partitions><partition id name discipline/></partitions>` 加实例
     `partition="id"`，再用 `<links><crosslink from to interface="…"/></links>` 声明跨分区边界。
     id 从 1 起，`id="0"` 报错（0 保留给「未分区」）；旧别名 `<link>` 已被拒绝。
     规范条文：§6.4（partition / crosslink）。
     crosslink 把 a.y（分区 1 输出）并入 b.s（分区 2 输入），`interface=` 声明边界变量。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L7_PartitionCrosslink">
  <modelTypes>
    <modelType name="Src">
      <parameters><parameter name="A" type="real" default="5.0"/></parameters>
      <variables><variable name="y" type="real" role="algebraic"/></variables>
      <equations><equation>y = A</equation></equations>
    </modelType>
    <modelType name="Snk">
      <variables><variable name="s" type="real" role="algebraic"/>
        <variable name="y" type="real" role="algebraic"/></variables>
      <equations><equation>y = s</equation></equations>
    </modelType>
  </modelTypes>
  <systems>
    <system name="Root">
      <partitions>
        <partition id="1" name="src" discipline="generic"/>
        <partition id="2" name="sink" discipline="generic"/>
      </partitions>
      <instances>
        <instance name="a" type="Src" partition="1"/>
        <instance name="b" type="Snk" partition="2"/>
      </instances>
      <links><crosslink from="a.y" to="b.s" portType="y s"/></links>
    </system>
  </systems>
</esml>
