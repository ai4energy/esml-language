<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 `<unitsBase>` 单位库基量容器：用 `base` / `scale` / `offset` 给出
     规范条文：附录 J（单位语义）。
     degC 与 K 的仿射换算。`check` 通过；求解得 T = 298.15 K。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L0_UnitsBase">
  <units>
    <unitsBase>
      <unit name="K"    base="K" scale="1" offset="0"/>
      <unit name="degC" base="K" scale="1" offset="273.15"/>
      <unit name="s"    base="s" scale="1" offset="0"/>
    </unitsBase>
  </units>
  <variableTypes>
    <type name="TempK" unit="K"    default="300.0"/>
    <type name="TempC" unit="degC" default="25.0"/>
  </variableTypes>
  <modelTypes><modelType name="M">
    <parameters><parameter name="Tamb" type="TempC"/></parameters>
    <variables><variable name="T" type="TempK" role="state" initial="300.0"/></variables>
    <equations><equation>D(T) = 0</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="g" type="M"/></instances>
  </system></systems>
</esml>