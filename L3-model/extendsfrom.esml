<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 `<extendsFrom>` 文本形态：Base 带参数 k，Child 与 Child2 两个子模型都以
     `<extendsFrom>` 继承 Base 并增加参数 u 与方程 y' = −k·y + u，同 system 内两实例并列。
     规范条文：§4.0（继承 `<extendsFrom>`）。
     canonical 拼法是 camelCase `extendsFrom`，kebab 写法会被拒绝。`check` errors=0。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L3_ExtendsFrom">
  <modelTypes>
    <modelType name="Base">
      <parameters><parameter name="k" type="real" default="0.3"/></parameters>
      <variables><variable name="x" type="real" role="state" initial="1.0"/></variables>
      <equations><equation>D(x) = -k * x</equation></equations>
    </modelType>
    <modelType name="Child">
      <extendsFrom>Base</extendsFrom>
      <parameters><parameter name="u" type="real" default="0.0"/></parameters>
      <variables><variable name="y" type="real" role="state" initial="0.0"/></variables>
      <equations><equation>D(y) = -k * y + u</equation></equations>
    </modelType>
    <modelType name="Child2">
      <extendsFrom>Base</extendsFrom>
      <parameters><parameter name="u" type="real" default="0.0"/></parameters>
      <variables><variable name="y" type="real" role="state" initial="0.0"/></variables>
      <equations><equation>D(y) = -k * y + u</equation></equations>
    </modelType>
  </modelTypes>
  <systems><system name="S">
    <instances>
      <instance name="c" type="Child"/>
      <instance name="d" type="Child2"/>
    </instances>
    <schedule><sequence><continueFor time="1"/></sequence></schedule>
  </system></systems>
</esml>
