<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 选择器：`<selectors><selector name>…</selector></selectors>` 加可选值域 `<values>`，
     以及系统级 `<initialSelectors><scope instance="…"><initialSelector path value/>` 设初值。
     规范条文：附录 B（续）— SELECTOR。
     `check` 通过；`solve`（system S）稳态解。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L3_Selector">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes><modelType name="M">
    <selectors><selector name="mode">
      <values><value>fast</value><value>slow</value></values>
      <default>fast</default>
    </selector></selectors>
    <variables><variable name="y" type="real" role="algebraic"/></variables>
    <equations><equation>y = 1.0</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="M"/></instances>
    <initialSelectors><scope instance="m"><initialSelector path="mode" value="fast"/></scope></initialSelectors>
    <schedule><sequence><continueFor time="0"/></sequence></schedule>
  </system></systems>
</esml>
