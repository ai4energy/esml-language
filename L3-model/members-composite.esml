<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 `<members>`：复合 modelType 包含内部成员实例。成员用点号路径聚合状态（a.x / b.x）。
     规范条文：§4.1（复合组件）。
     `<members>` 内的 `<instance>` 与 system 内的 `<instance>` 同型，命名空间在复合内。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L3_Members">
  <modelTypes>
    <modelType name="Leaf">
      <parameters><parameter name="k" type="real" default="0.3"/></parameters>
      <variables><variable name="x" type="real" role="state" initial="1.0"/></variables>
      <equations><equation>Der(x) = -k * x</equation></equations>
    </modelType>
    <modelType name="Body">
      <members>
        <instance name="a" type="Leaf"/>
        <instance name="b" type="Leaf"/>
      </members>
      <variables><variable name="y" type="real" role="state" initial="0.0"/></variables>
      <equations><equation>Der(y) = -(a.x + b.x)</equation></equations>
    </modelType>
  </modelTypes>
  <systems><system name="S">
    <instances><instance name="body" type="Body"/></instances>
    <schedule><sequence><continueFor time="1"/></sequence></schedule>
  </system></systems>
</esml>
