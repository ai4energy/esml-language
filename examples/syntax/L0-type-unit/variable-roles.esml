<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 变量角色：`<parameters>` 常数、`<discrete>` 事件触发的离散变量、
     `role="state"` 状态（可被 `D(...)` 求导）与 `role="algebraic"` 代数未知量（默认）。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L0_Roles">
  <modelTypes><modelType name="M">
    <parameters>
      <parameter name="k" type="real" default="1.0"/>
    </parameters>
    <discrete>
      <variable name="flag" type="real" default="0.0"/>
    </discrete>
    <variables>
      <variable name="x" type="real" role="state" initial="1.0"/>
      <variable name="a" type="real" role="algebraic"/>
    </variables>
    <equations>
      <equation>D(x) = -k * x</equation>
      <equation>a = x * x</equation>
    </equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="M"/></instances>
    <schedule><sequence><continueFor time="1"/></sequence></schedule>
  </system></systems>
</esml>
