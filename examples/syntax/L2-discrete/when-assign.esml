<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 `<when>` 加 `<assign>`：离散变量在事件时刻被赋值并保持。
     滞回开关：T > Tbar + 1 时 on := 1；T < Tbar − 1 时 on := 0；
     用 `pre()` 引用上一事件后保持的值。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L2_WhenAssign">
  <variableTypes><type name="real" unit="1" default="0.0" role="algebraic"/></variableTypes>
  <modelTypes><modelType name="Hysteresis">
    <parameters>
      <parameter name="Tbar" type="real" default="0.0"/>
      <parameter name="k"    type="real" default="1.0"/>
    </parameters>
    <discrete>
      <variable name="on" type="real" default="0.0"/>
    </discrete>
    <variables>
      <variable name="T" type="real" role="state" initial="0.0"/>
      <variable name="u" type="real" role="algebraic"/>
    </variables>
    <equations>
      <equation>D(T) = -k * (T - u)</equation>
      <equation>u = pre(on) * 10.0</equation>
    </equations>
    <events>
      <when condition="T &gt; Tbar + 1">
        <assign path="on" value="1.0"/>
      </when>
      <when condition="T &lt; Tbar - 1">
        <assign path="on" value="0.0"/>
      </when>
    </events>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="Hysteresis"/></instances>
    <schedule><sequence><continueFor time="1"/></sequence></schedule>
  </system></systems>
</esml>
