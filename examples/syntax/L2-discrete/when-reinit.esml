<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 `<events><when condition><reinit name value/></when></events>`：连续状态在事件时刻被重置。
     弹球触地（h < 0）时速度反向并乘回弹系数；reinit 到 h = 1e-5 是「抬离触面」的惯例
     （相切不触发）。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L2_WhenReinit">
  <variableTypes><type name="real" unit="1" default="0.0" role="algebraic"/></variableTypes>
  <modelTypes><modelType name="Ball">
    <parameters>
      <parameter name="g"    type="real" default="9.81"/>
      <parameter name="rest" type="real" default="0.9"/>
    </parameters>
    <variables>
      <variable name="h" type="real" role="state" initial="1.0"/>
      <variable name="v" type="real" role="state" initial="0.0"/>
    </variables>
    <equations>
      <equation>D(h) = v</equation>
      <equation>D(v) = -g</equation>
    </equations>
    <events>
      <when condition="h &lt; 0.0">
        <reinit path="v" value="-rest * v"/>
        <reinit path="h" value="1e-5"/>
      </when>
    </events>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="Ball"/></instances>
    <schedule><sequence><continueFor time="1"/></sequence></schedule>
  </system></systems>
</esml>
