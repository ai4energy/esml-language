<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 任务附属的设定点 `<setpoint>`：可选属性 `var=` / `value=`，
     也可用子元素 `<var name value/>`。实现作为元数据接受并跳过，不做控制。
     规范条文：§6.9（计算任务表）。
     `check` errors=0，`tasks` exit=0。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="T_TaskSetpoint">
  <variableTypes><type name="real" unit="1" default="0.0" role="algebraic"/></variableTypes>
  <modelTypes><modelType name="DecayModel" discipline="generic">
    <parameters><parameter name="lambda" type="real" default="0.05"/></parameters>
    <variables><variable name="N" type="real" role="state" initial="100.0"/></variables>
    <equations><equation>Der(N) = -lambda * N</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="g" type="DecayModel"/></instances>
    <schedule><sequence><continueFor time="60"/></sequence></schedule>
  </system></systems>
  <computeTasks name="t-sp" target="S">
    <task name="sim" kind="simulate">
      <tspan from="0" to="60"/>
      <solver name="Tsit5"/>
      <setpoint var="g.N" value="4.98">
        <var name="g.lambda" value="0.05"/>
      </setpoint>
    </task>
  </computeTasks>
</esml>
