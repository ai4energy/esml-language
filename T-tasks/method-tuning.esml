<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- optimize 任务的 method 调参属性（samples / timestep / generations / population）。 -->
<!-- 规范条文：待补（本属性仅 XSD 声明，SPEC 尚未成文；XSD 锚点 esml-canonical-compute.xsd 的 method 元素）。 -->
<!-- check errors=0。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="T_MethodTuning">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes><modelType name="DecayModel" discipline="generic">
    <parameters><parameter name="lambda" type="real" default="0.05"/></parameters>
    <variables><variable name="N" type="real" role="state" initial="100.0"/></variables>
    <equations><equation>Der(N) = -lambda * N</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="g" type="DecayModel"/></instances>
    <schedule><sequence><continueFor time="60"/></sequence></schedule>
  </system></systems>
  <computeTasks name="t-task" target="S">
    <task name="opt" kind="optimize">
      <tspan from="0" to="60"/>
      <decision name="x" lower="0" upper="10"/>
      <objective direction="min">(x-3)^2</objective>
      <method name="ga" samples="100" timestep="0.1" generations="50" population="20"/>
    </task>
  </computeTasks>
</esml>
