<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 `<task kind="surrogate"><surrogate …/><sampling size/></task>`：
     `<sampling>` 是 `<task>` 的直接子元素；`<task>` 又必须在
     `<esml><computeTasks name=… target=…>` 里（顶层 `<computeTasks>`
     不是文档根，F3 拒收）。`size` 必填。
     check errors=0（T 层）。
     规范条文：§6.9（计算任务表）。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="T_Sampling">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes><modelType name="M" discipline="generic">
    <parameters>

    <parameter name="rate" type="real" default="0.05"/>
  </parameters>
    <variables><variable name="N" type="real" role="state" initial="100.0"/></variables>
    <equations><equation>Der(N) = -rate * N</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S"><instances><instance name="g" type="M"/></instances><schedule><sequence><continueFor time="1"/></sequence></schedule></system></systems>
  <computeTasks name="t" target="S"><task name="d" kind="surrogate"><surrogate method="lsq" degree="1"/><sampling size="20"/></task></computeTasks>
</esml>
