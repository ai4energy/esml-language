<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 负例（预期失败）：任务外层壳用 `<computeTask>`（单数）形态。legacy 拼法，
     XSD 拒收（esml 根只声明复数 `<computeTasks>`）；canonical 用 `<computeTasks>`，
     见 T-tasks/actuator.esml 等正例。非零退出是预期行为。
     规范条文：§6.8 计算任务表（不是 `<computeTask>`；canonical 只收 `<computeTasks>`）。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="T_ComputeTaskProbe">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes><modelType name="Decay" discipline="generic">
    <variables><variable name="N" type="real" role="state" initial="1.0"/></variables>
    <equations><equation>Der(N) = -N</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="g" type="Decay"/></instances>
    <schedule><sequence><continueFor time="1"/></sequence></schedule>
  </system></systems>
  <computeTask name="t" target="S">
    <task name="sim" kind="simulate"><tspan from="0" to="1"/></task>
  </computeTask>
</esml>
