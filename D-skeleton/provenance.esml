<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 `<metadata>` 下的 `<provenance>` 子元素，用于声明文档出处。
     规范条文：§1.1（文档骨架与 `<metadata>`）。
     它与 `author` / `description` 同处 `<metadata>`，不参与求解。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="D_Provenance">
  <metadata>
    <author>Ai4Energy ESML Syntax Examples</author>
    <provenance>re-implementation of an earlier tank model</provenance>
  </metadata>
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes><modelType name="M">
    <variables><variable name="x" type="real" role="algebraic"/></variables>
    <equations><equation>x = 1.0</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="M"/></instances>
    <schedule><sequence><continueFor time="0"/></sequence></schedule>
  </system></systems>
</esml>
