<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 文档引用 `<doc>`（DocRefType）：`ref` 必填（指向文档条目的唯一键），
     `title` / `summary` 可省；`summary` 亦可写作元素文本（本例即用元素文本形态）。
     三处同型：`<metadata>` 内（本例）、`<modelType>` 内、`<portType>` 内。
     纯文档元数据，不参与编译与求解。
     规范条文：§1.1（文档骨架 · 就地短文档引用 `<doc>`，纯文档元数据）。
     `check` errors=0。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="D_DocRef">
  <metadata>
    <doc ref="esml-manual:thermal-chain" title="热链文档条目">
      指数衰减热链的文档引用示例：doc 只做引用与摘要，不进求解。
    </doc>
  </metadata>
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes>
    <modelType name="Decay" discipline="generic">
      <parameters><parameter name="k" type="real" default="0.05"/></parameters>
      <variables><variable name="N" type="real" role="state" initial="100.0"/></variables>
      <equations><equation>Der(N) = -k * N</equation></equations>
    </modelType>
  </modelTypes>
  <systems>
    <system name="S">
      <instances><instance name="g" type="Decay"/></instances>
      <schedule><sequence><continueFor time="60"/></sequence></schedule>
    </system>
  </systems>
</esml>
