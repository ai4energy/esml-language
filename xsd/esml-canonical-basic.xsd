<?xml version="1.0" encoding="UTF-8"?>
<!--
  ESML canonical — model-system basic subset。

  自包含、可被 XSD 校验器编译的 canonical 子集：覆盖模型体系逐层基本件
  单位 units → 变量类型 variableTypes(类别 wrapper) → 模型/变量/参数
  (modelType: parameters/variables/equations) → 端口 portTypes/port + connection →
  复合 <members>(instance) → 系统 systems(instances/sets/initial/connections)
  → 坐标库 <use library="g:a:v"/>。

  注意：
  - 求解/计算任务(schedule/tasks/solver)属计算求解体系，不在本 schema。
  - instance 为主词（系统与 <members> 内）；旧拼写 <component> **不是合法语法**，
    本 schema 只认 <instance>（同一语义只留一个名字，SPEC §2）。
  - 子系统间边界写作 <crosslink>（容器为 <links>）；旧拼写 <link> 不是合法语法，
    本 schema 只认 <crosslink>。
  - 严格子集：仅列出的模型体系元素可校验；其他顶层段不在本 schema 覆盖范围内
    （通配与命名兄弟元素会触发 UPA 冲突，故不混排）。

  校验：python3 -c "import xmlschema; xmlschema.XMLSchema('xsd/esml-canonical-basic.xsd').validate('<file>')"
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:esml="https://www.ai4energy.cn/esml/v1"
           targetNamespace="https://www.ai4energy.cn/esml/v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0.0">

  <xs:include schemaLocation="esml-canonical-common.xsd"/>
  <xs:include schemaLocation="esml-canonical-compute.xsd"/>
  <xs:complexType name="UseType">
    <xs:sequence>
      <!-- `<use><unit name="real" procedure="standard"/></use>` — a reference
           clause, not a declaration (hence `UnitRefType`). -->
      <xs:element name="unit" type="esml:UnitRefType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="library" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 单位（单位表即库） -->
  <!--
    单位词法（`UnitExpressionType` / `UnitNumberType`）定义在
    `esml-canonical-common.xsd`（basic 与 compute 都 include 的共享层），
    本文件的 `base=` / `unit=` 与 compute 的 `unit=` 共用同一文法。
  -->
  <!-- 声明：`<units>` / `<unitsBase>` / `<unitsDerived>` / `<group>` 里的
       `<unit>`。`name` 是**标签**，`base` 是**定义式（锚点的唯一来源）**，
       `scale`/`offset` 是仿射映射。不再用 anyAttribute 放行拼写错误。 -->
  <xs:complexType name="UnitDeclType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="base" type="esml:UnitExpressionType" use="optional"/>
    <xs:attribute name="scale" type="esml:UnitNumberType" use="optional"/>
    <xs:attribute name="offset" type="esml:UnitNumberType" use="optional"/>
    <xs:attribute name="symbol" type="xs:string" use="optional"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
  </xs:complexType>
  <!-- 引用：`<use><unit name="real" procedure="standard"/></use>` —— 与「声明」
       语义不同，故单列一类型（旧 UnitType 兼两义是过载）。 -->
  <xs:complexType name="UnitRefType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="procedure" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="UnitsBaseType">
    <xs:sequence>
      <xs:element name="unit" type="esml:UnitDeclType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <!-- <unitsDerived> may carry either loose <unit> leaves or
       <group name="..."> sub-buckets; leaves are collected depth-first. -->
  <xs:complexType name="UnitsDerivedType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="group">
          <xs:complexType><xs:sequence>
            <xs:element name="unit" type="esml:UnitDeclType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="unit" type="esml:UnitDeclType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="UnitsLibraryType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <!-- <description> doc-block at top of <units>; its content is not
           interpreted, only accepted structurally. -->
      <xs:element name="description" minOccurs="0">
        <xs:complexType mixed="true">
          <xs:sequence>
            <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:anyAttribute processContents="lax"/>
        </xs:complexType>
      </xs:element>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="unitsBase"    type="esml:UnitsBaseType"/>
        <xs:element name="unitsDerived" type="esml:UnitsDerivedType"/>
      </xs:choice>
    </xs:choice>
    <!-- `<units>` 上可写 `name`（如 `base-units` / `esml-units` / `u`）；
         本类型**显式声明**它，而非经 anyAttribute 放行。 -->
    <xs:attribute name="name" type="xs:string" use="optional"/>
  </xs:complexType>
  <!-- 兼容旧名：`UnitType` 仍指向声明类型（外部引用可能使用它）。 -->
  <xs:complexType name="UnitType">
    <xs:complexContent>
      <xs:extension base="esml:UnitDeclType"/>
    </xs:complexContent>
  </xs:complexType>

  <!-- 序集：top-level `<orderedSet name="..." static="...">`
       包装 `<element>` 子项。 -->
  <xs:complexType name="OrderedSetElementType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:anyAttribute processContents="lax"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="OrderedSetType">
    <xs:sequence>
      <xs:element name="element" type="esml:OrderedSetElementType"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="static" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 元数据自由文本子元素（author/license/description/provenance）：
       纯文本承载，无属性、无子元素（SPEC：「写什么都不改变方程数」）。 -->
  <xs:complexType name="MetadataFreeTextType">
    <xs:simpleContent>
      <xs:extension base="xs:string"/>
    </xs:simpleContent>
  </xs:complexType>

  <!-- 文档元数据：author/license/description/provenance 等自由键值块；
       仅存于文档根，子结构不被强制消费。
       SPEC §1.1：「常用子元素 `<author>` / `<license>` / `<description>` /
       `<provenance>`。其**子结构不固定**（schema 放行任意子元素）」——
       条文**明文要求**放行任意子元素，故本容器**必须**保留 `xs:any`
       （把通配删掉换成封闭声明＝推翻条文，XSD 1.0 也不允许同一 choice 组内
       命名元素与 `##targetNamespace` 通配并存）。strict 闸下 metadata 的
       3 件红（`D-skeleton/metadata.esml` / `provenance.esml` / `doc-ref.esml`）
       是**条文与通配撤除的既定冲突**——SPEC 点名「放行任意子元素」，
       撤掉通配即推翻条文，故这 3 件是规范债（条文欠账），非示例错、
       非 schema 欠账，基线 `docs/audit/strict-baseline.txt` 即其口径。
       SPEC 点名的四者 + `<doc>` 另在**全局元素层**有真声明（下）：
       嵌套在 `<esml>` 根的 `<metadata>` 下走本容器通配（见上条），
       全局层声明保留是为「库根 `<metadata>` 独立文档」这一 SPEC §13
       点名的合法根形态——当前语料无此根（`root_of` 计数只有
       esml/project），若 SPEC 日后增补该形态的示例，直接可用。 -->
  <xs:complexType name="MetadataType" mixed="true">
    <xs:sequence>
      <xs:any namespace="##targetNamespace" processContents="lax"
              minOccurs="0" maxOccurs="unbounded"/>
      <xs:any namespace="##other" processContents="skip"
              minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- T-DOCREF：就地短文档引用（`parse_doc_ref`）。三处同型：
         `<metadata><doc …/>`、`<modelType><doc …/>`、`<portType><doc …/>`。
       `ref=` 是指向文档条目的唯一键；`title`/`summary` 可作属性，`summary`
       亦可作元素文本 —— 故 mixed。 -->
  <xs:complexType name="DocRefType" mixed="true">
    <xs:sequence>
      <xs:any namespace="##other" processContents="skip"
              minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="ref" type="xs:string" use="required"/>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="summary" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 顶层 `<domains><domain name><discretization method order intervals/></domain></domains>`
       文档语义只需要 `name` 与 `discretization@intervals`；`lowerBound`/`upperBound`/
       `method`/`order` 作为扩展属性接受，不参与求解语义。 -->
  <xs:complexType name="DomainType">
    <xs:sequence>
      <xs:element name="discretization" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="method" type="xs:string" use="optional"/>
          <xs:attribute name="order" type="xs:positiveInteger" use="optional"/>
          <xs:attribute name="intervals" type="xs:positiveInteger" use="optional"/>
          <xs:anyAttribute processContents="lax"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="lowerBound" type="xs:double" use="optional"/>
    <xs:attribute name="upperBound" type="xs:double" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="DomainsType">
    <xs:sequence>
      <xs:element name="domain" type="esml:DomainType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 求解器条目：`<solver name abstol reltol saveat maxsteps/>`。SPEC §6.9
       两处出现：`<computeTasks>` 内 kind=simulate/optimize 的载荷，与顶层
       `<solutionParameters>` 的子元素形态（属性同形，见 SPEC:799 子元素形态
       示例，`saveat`/`maxsteps` 即该处所写）。本处是基本层对 `<solver>` 的
       **首次真声明**：此前 basic 侧只有 `##targetNamespace` 通配兜着，
       strict 闸（撤 xs:any）下 `<solutionParameters><solver>` 整树红
       （"character data is not allowed because content is empty" 即
       targetNS 通配撤掉后 `<solver>` 子树无声明可挂、被当作未解析内容
       的 libxml 措辞）。compute.xsd 内 task 下的 `<solver>` 是局部声明，
       两处属性集一致，本处复用同形不另造分歧。 -->
  <xs:complexType name="SolverType">
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="abstol" type="xs:double" use="optional"/>
    <xs:attribute name="reltol" type="xs:double" use="optional"/>
    <xs:attribute name="saveat" type="xs:double" use="optional"/>
    <xs:attribute name="maxsteps" type="xs:int" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 求解参数容器：字面量容器，不参与求解语义（真正生效的求解设置来自
       `<task>` 或调用参数）。两种形状均可：仅属性，或带 `<solver>` 子项。
       W9 把 `##targetNamespace` 通配换成 `<solver>` 真声明：SPEC 只给了
       这一种子元素（§6.9 子元素形态），通配既无条文支撑也撑不起 strict
       闸；`##other` 那条（skip，放行外命名空间内容）保留 —— XSD 1.0 下
       目标命名空间一旦给出真声明，外命名空间的兜底仍需独立 any。 -->
  <xs:complexType name="SolutionParametersType">
    <xs:sequence>
      <xs:element name="solver" type="esml:SolverType"
                  minOccurs="0" maxOccurs="unbounded"/>
      <xs:any namespace="##other" processContents="skip"
              minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="optional"/>
    <xs:attribute name="abstol" type="xs:double" use="optional"/>
    <xs:attribute name="reltol" type="xs:double" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 宿主对象：`<foreignObjects><foreignObject name class><method
       name><set path value/></method></foreignObject></foreignObjects>`。
       方法体**只有** `<set>` —— 其余子元素被拒收，schema 与之一致。 -->
  <xs:complexType name="ForeignSetType">
    <xs:attribute name="path" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="optional" default="0"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="ForeignMethodType">
    <xs:sequence>
      <xs:element name="set" type="esml:ForeignSetType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="ForeignObjectType">
    <xs:sequence>
      <xs:element name="method" type="esml:ForeignMethodType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="class" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="ForeignObjectsType">
    <xs:sequence>
      <xs:element name="foreignObject" type="esml:ForeignObjectType"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 方法表条目形状：
       - `<onLoad><set path value/>…</onLoad>`（附录 F5：模型级预设，set 可任意多个）；
       - `<method name><set path value/>…</method>`（附录 F7b：具名子过程，
         方法体按 SPEC:96/附录 F7b 只收 `<set>`）；
       - `<fix name value?/>` / `<vary name/>`（附录 K：method 内 FIX/FREE，
         与系统级 `<fixed>/<free>` 同一实现路径）；
       - `<free name/>`（自由释放）；
       - `<run name/>`（附录 F7b：顺序调用另一 method，run/call 同义）。
       W9 把 `##targetNamespace` 通配换成上述封闭声明：strict 闸下通配撤掉后
       方法体整树红，而 SPEC 对命令集是**封闭列举**（set/fix/vary/free/run
       五件，无开放条款），故按条文封死、不新开前缀。
       仓内语料实测（2026-11）：`<methods>` 只出现在 L9-method-schedule 三件
       （onload / methods-run / call-method-body），子元素恰为上述五类，
       封死后全绿。`<call method=/>` 不在此处 —— 它属于 `<schedule><sequence>`
       步类型（附录 K），由 Schedule 侧声明。 -->
  <xs:complexType name="MethodSetType">
    <xs:attribute name="path" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="MethodOnLoadType">
    <xs:sequence>
      <xs:element name="set" type="esml:MethodSetType"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="MethodDefType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="set" type="esml:MethodSetType"/>
        <xs:element name="fix" type="esml:MethodFixType"/>
        <xs:element name="free" type="esml:MethodFreeType"/>
        <xs:element name="vary" type="esml:MethodVaryType"/>
        <xs:element name="run" type="esml:MethodRunType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="MethodFixType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="MethodFreeType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="MethodVaryType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="MethodRunType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="MethodsType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="onLoad" type="esml:MethodOnLoadType"/>
        <xs:element name="method" type="esml:MethodDefType"/>
        <xs:element name="fix" type="esml:MethodFixType"/>
        <xs:element name="free" type="esml:MethodFreeType"/>
        <xs:element name="vary" type="esml:MethodVaryType"/>
        <xs:element name="run" type="esml:MethodRunType"/>
      </xs:choice>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- L-ANNOT · 图形/图标/摆位/端口落点（不进语义；求解器忽略；随模型走；可 diff） -->
  <!-- 最小字段集：
         <icon src="..." w="..." h="..."/>          类型级；仓内相对路径或 data:image/svg+xml;base64,...
         <placement x y w h rot/>                   实例级；rot 默认 0
         <port name side offset/>                   端口落点；side=top|bottom|left|right|center
       ★ 方向不新增字段 ✗ —— 由 <portVariable portRole="potential|flow"> 推导
       ★ dims 属于真语义 ⇒ 不在 L-ANNOT 本期（开另一只活） -->
  <xs:complexType name="IconType">
    <xs:attribute name="src" type="xs:string" use="required"/>
    <xs:attribute name="w" type="xs:double" use="optional"/>
    <xs:attribute name="h" type="xs:double" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="PlacementType">
    <xs:attribute name="x" type="xs:double" use="optional"/>
    <xs:attribute name="y" type="xs:double" use="optional"/>
    <xs:attribute name="w" type="xs:double" use="optional"/>
    <xs:attribute name="h" type="xs:double" use="optional"/>
    <xs:attribute name="rot" type="xs:double" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:simpleType name="PortSideType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="top"/>
      <xs:enumeration value="bottom"/>
      <xs:enumeration value="left"/>
      <xs:enumeration value="right"/>
      <xs:enumeration value="center"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="PortMarkType">
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="side" type="esml:PortSideType" use="required"/>
    <xs:attribute name="offset" type="xs:double" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="AnnotationType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="icon" type="esml:IconType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="placement" type="esml:PlacementType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="port" type="esml:PortMarkType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 枚举字面量（SPEC:152：`type E = enumeration(a,b,c)` 字面量也可用
       子元素 `<literal name="a"/>`）。W9 补真声明：VariableType 原先无
       子元素声明，`<literal>` 只能靠上层 anyAttribute 旁路，strict 闸下
       枚举例（type-unit.esml 等）会红。 -->
  <xs:complexType name="LiteralType">
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 变量类型：裸放或类别 wrapper（<typesGeneric> 等 types* 族）内 <type> -->
  <xs:complexType name="VariableType">
    <xs:sequence>
      <xs:element name="literal" type="esml:LiteralType"
                 minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="unit" type="esml:UnitExpressionType" use="optional"/>
    <xs:attribute name="quantity" type="xs:string" use="optional"/>
    <xs:attribute name="lowerBound" type="xs:string" use="optional"/>
    <xs:attribute name="upperBound" type="xs:string" use="optional"/>
    <xs:attribute name="default" type="xs:string" use="optional"/>
    <xs:attribute name="nominal" type="xs:string" use="optional"/>
    <xs:attribute name="role" type="xs:string" use="optional"/>
    <!-- `kind="enumeration"` with comma-separated `values`; literals may
         also be child `<literal name=.../>`. The source spelling
         `type E = enumeration(...)` is accepted and normalized by the
         converter. -->
    <xs:attribute name="kind" type="xs:string" use="optional"/>
    <xs:attribute name="values" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="TypesCategoryType">
    <xs:sequence>
      <xs:element name="type" type="esml:VariableType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <!-- W9：`discipline=` 由 anyAttribute 兜底改为真声明。SPEC:173（§1
         「类型按类别包裹」）明写 wrapper 带「`discipline=` 可选」；
         strict 闸（撤 anyAttribute）下语料 L6-connect/connect-rules.esml
         的 `<typesDimensionless discipline="generic">` 因此转红，补上。 -->
    <xs:attribute name="discipline" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- `<variableTypes>` 容器（W9 补真声明，此前全靠 `xs:any` 通配当声明，
       strict 闸 123 件红中 117 件首因在此）。合法子元素集合按 SPEC §1
       「类型按类别包裹（wrapper）」条文**封闭**为：
         1. 裸 `<type>`（VariableType）
         2. `<typesGeneric>` / `<typesThermal>` / `<typesDimensionless>`
            —— 各含若干 `<type>`，`discipline=`/`name=` 可选（TypesCategoryType）。
       **wrapper 前缀不是开放枚举**：SPEC 只点名上述三个（`grep '按类别' SPEC.md`
       无 `types-` 开放前缀条文），故**不**对未知 wrapper 保留宽容——新增
       `<typesElectrical>` 之类须先改 SPEC 条文再补声明，否则 XSD 响亮拒收
       （这正是本闸要的判别力：错拼/未裁决的拼法不许靠通配静默绿）。
       裸 `<type>` 的 `<literal name=…/>` 子元素（SPEC:152 枚举字面量，
       VariableType 注释亦点名）一并补进 VariableType。 -->
  <xs:complexType name="VariableTypesType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="type" type="esml:VariableType"/>
        <xs:element name="typesGeneric" type="esml:TypesCategoryType"/>
        <xs:element name="typesThermal" type="esml:TypesCategoryType"/>
        <xs:element name="typesDimensionless" type="esml:TypesCategoryType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 端口：port-type 变量束 + port 实例 -->
  <!-- 端口：port-type 变量表 + port 实例。
       `array`：与 `VariableDeclType`（`<variable>`/`<parameter>`）写法一致 ——
       流股可携带**组分数组**（如 `w_i, i ∈ C`），端口变量必须能声明维度，
       否则"组成随流股走"表达不了（见 SPEC.md §5）。
       展开规则同 §9：`array="n"` → `name_1..name_n`（含 `array="Species"` 的
       ordered-set 维度）、`array="n,m"` → `name_i_j`。
       注：`role` 与 `array` 正交 —— 显式域端口（工艺/热/流）通常**无 role**。 -->
  <xs:complexType name="PortVariableType">
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="type" type="xs:string" use="optional"/>
    <xs:attribute name="array" type="xs:string" use="optional"/>
    <!-- `portRole` / `causality` / `carrier`：端口变量的角色属性形（单轨拼法，
         见 SPEC §5）。元素名给角色的写法（`<flow>` 等）已按单轨裁决删除。 -->
    <xs:attribute name="portRole" type="xs:string" use="optional"/>
    <xs:attribute name="causality" type="xs:string" use="optional"/>
    <xs:attribute name="carrier" type="xs:string" use="optional"/>
    <!-- `initial` / `default`：端口变量的初值/类型默认。注意端口变量的**值**由连接
         或单元内方程给（§8），这里的两项只是**求解起点**，不是"钉值"。 -->
    <xs:attribute name="initial" type="xs:string" use="optional"/>
    <xs:attribute name="default" type="xs:string" use="optional"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="PortTypeDef">
    <xs:sequence>
      <!-- 单轨（裁决 A，2026-11-10）：端口变量只认 `<portVariable>`（角色由
           `portRole=` 属性给出）；元素名给角色的写法（`<var>` `<flow>` 等 7 种
           拼法）是同语义的并行拼法，已从两处 choice 中删除。 -->
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <!-- 端口类型的就地短文档（`parse_doc_ref`，与 metadata 里的 `<doc>` 同型）。 -->
        <xs:element name="doc" type="esml:DocRefType"/>
        <xs:element name="variables" minOccurs="0">
          <xs:complexType><xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="portVariable"  type="esml:PortVariableType"/>
            </xs:choice>
          </xs:sequence></xs:complexType>
        </xs:element>
        <xs:element name="portVariable"  type="esml:PortVariableType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <!-- `domain` 保留（引擎 XSD 与 SPEC L83 仍存旧拼写讨论；仓外存量 `domain=`
         不能失去落点）：是否退役留待单轨复核。 -->
    <xs:attribute name="domain" type="xs:string" use="optional"/>
    <xs:attribute name="connectorFamily" type="xs:string" use="optional"/>
    <xs:attribute name="conservation" type="xs:string" use="optional"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="PortInstanceType">
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="portType" type="xs:string" use="optional"/>
    <xs:attribute name="category" type="xs:string" use="optional"/>
    <xs:attribute name="size" type="xs:string" use="optional"/>
    <!-- `count` 保留：SPEC 属性集无此项，但引擎 XSD 在 InstRefType 上声明、
         本类型已有，两边都留（单轨复核再定）。 -->
    <xs:attribute name="count" type="xs:string" use="optional"/>
    <xs:attribute name="connectClass" type="xs:string" use="optional"/>
    <xs:attribute name="portSet" type="xs:string" use="optional"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 组件 model-type -->
  <xs:complexType name="ParameterType">
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="type" type="xs:string" use="optional"/>
    <xs:attribute name="default" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="VariableDeclType">
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="type" type="xs:string" use="optional"/>
    <xs:attribute name="role" type="xs:string" use="optional"/>
    <xs:attribute name="initial" type="xs:string" use="optional"/>
    <xs:attribute name="default" type="xs:string" use="optional"/>
    <xs:attribute name="array" type="xs:string" use="optional"/>
    <xs:attribute name="distribution" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- Event action: <assign> / <reinit> inside <when>. Both require path= and value=. -->
  <xs:complexType name="EventActionType">
    <xs:attribute name="path" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- <when condition="…"> block; <elsewhen> reuses the same type (recursive). -->
  <xs:complexType name="WhenType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="assign" type="esml:EventActionType"/>
      <xs:element name="reinit" type="esml:EventActionType"/>
      <xs:element name="elsewhen" type="esml:WhenType"/>
    </xs:choice>
    <xs:attribute name="condition" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="InstRefType">
      <xs:sequence>
        <xs:element name="set" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="domain" type="xs:string" use="optional"/>
    <xs:attribute name="extendsFrom" type="xs:string" use="optional"/>
    <!-- 所属 partition id（缺省/未分区 = 0）。 -->
    <xs:attribute name="partition" type="xs:unsignedInt" use="optional"/>
    <!-- 条件组件（语言规范 §6.5）：构建期可判的布尔
         表达式，为假时该实例及其连接被排除；缺省 = 恒真。 -->
    <xs:attribute name="condition" type="xs:string" use="optional"/>
    <!-- 与 PortInstanceType 同型：实例重复份数（两边都留，单轨复核再定）。 -->
    <xs:attribute name="count" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="ConnectType">
    <xs:attribute name="from" type="xs:string" use="optional"/>
    <xs:attribute name="to" type="xs:string" use="optional"/>
    <!-- 连接种类 + 端点分区 + 边界接口表。 -->
    <xs:attribute name="kind" type="xs:string" use="optional"/>
    <xs:attribute name="aPart" type="xs:unsignedInt" use="optional"/>
    <xs:attribute name="bPart" type="xs:unsignedInt" use="optional"/>
    <xs:attribute name="portType" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- 一等 partition（稳定 id + name/discipline + 可选 time layer）。
       `id` is 1-based: 0 is reserved for "unpartitioned" (`instance@partition=0`).
       学科域的 canonical 拼写是 `discipline=`（与 `<modelType discipline=>`、
       `<system discipline=>` 同词），跨时层是 `timeLayer=`；旧拼写 `domain=` /
       `time-layer=` 由实现当作别名归一，schema 侧经 `anyAttribute` 仍放行，
       但**不作为显式声明**——显式声明的只能是 canonical 拼写。 -->
  <xs:complexType name="PartitionType">
    <xs:attribute name="id" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:unsignedInt">
          <xs:minInclusive value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="discipline" type="xs:string" use="optional"/>
    <xs:attribute name="timeLayer" type="xs:unsignedInt" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- record-type 目录（可选）。 -->
  <xs:complexType name="RecordTypeDef">
    <xs:sequence>
      <xs:element name="field" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="type" type="xs:string" use="optional"/>
          <xs:attribute name="default" type="xs:string" use="optional"/>
          <xs:attribute name="role" type="xs:string" use="optional"/>
          <xs:attribute name="unit" type="esml:UnitExpressionType" use="optional"/>
          <xs:anyAttribute processContents="lax"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- 时钟分区（可选）。 -->
  <xs:complexType name="ClockType">
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="interval" type="xs:string" use="optional"/>
    <xs:attribute name="phase" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- 状态机（可选）。 -->
  <xs:complexType name="StateMachineType">
    <xs:sequence>
      <xs:element name="state" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:any namespace="##targetNamespace" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="initial" type="xs:string" use="optional"/>
          <xs:attribute name="initialState" type="xs:string" use="optional"/>
          <xs:anyAttribute processContents="lax"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="transition" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="from" type="xs:string" use="optional"/>
          <xs:attribute name="to" type="xs:string" use="optional"/>
          <xs:attribute name="condition" type="xs:string" use="optional"/>
          <xs:attribute name="priority" type="xs:string" use="optional"/>
          <xs:attribute name="immediate" type="xs:string" use="optional"/>
          <xs:attribute name="reset" type="xs:string" use="optional"/>
          <xs:attribute name="synchronize" type="xs:string" use="optional"/>
          <xs:anyAttribute processContents="lax"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="ModelType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <!-- 可选文档性说明（规范 §4）：人写在组件上的整段描述 -->
      <xs:element name="description" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <!-- T-DOCREF：类型级就地短文档（与 `<metadata>` / `<portType>` 内同型）。 -->
      <xs:element name="doc" type="esml:DocRefType" minOccurs="0" maxOccurs="unbounded"/>
      <!-- 初始猜测（modelType 级；`scope@instance` 可省）。 -->
      <xs:element name="initial" type="esml:ModelInitialType" minOccurs="0" maxOccurs="1"/>
      <!-- L-ANNOT：图形/图标/摆位/端口落点；不进语义，求解器忽略；可多份并列 -->
      <xs:element name="annotation" type="esml:AnnotationType" minOccurs="0" maxOccurs="unbounded"/>
      <!-- 选择器（规范附录 SELECTOR / CASE·STN）：<selectors><selector …/></selectors> -->
      <xs:element name="selectors" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
      <!-- 基类（子元素文本，逗号分隔）。canonical 拼法是 camelCase `extendsFrom`
           （规范 §4.0）；kebab `extends-from` 不是合法语法，不在此声明。 -->
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="extendsFrom" type="xs:string"/>
      </xs:choice>
      <xs:element name="ports" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="port" type="esml:PortInstanceType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="parameters" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="parameter" type="esml:ParameterType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="variables" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="variable" type="esml:VariableDeclType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="equations" minOccurs="0">
        <xs:complexType><xs:choice minOccurs="0" maxOccurs="unbounded">
          <!-- 选择器 <case>（规范附录 SELECTOR / CASE·STN） -->
          <xs:element name="case" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
          <!-- 模型级条件 <if>（规范附录「模型级 IF」：对称可逆，两分支 lhs 须一致，
               语义为 lhs = ifelse(c, rhsA, rhsB)） -->
          <xs:element name="if" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
          <!-- 方程级 <for var in="lo..hi"> 循环（规范附录「FOR 循环」）。 -->
          <xs:element name="for" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="equation" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType mixed="true">
              <xs:sequence><xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
              <xs:attribute name="name" type="xs:string" use="optional"/>
              <xs:attribute name="description" type="xs:string" use="optional"/>
              <xs:anyAttribute processContents="lax"/>
            </xs:complexType>
          </xs:element>
        </xs:choice></xs:complexType>
      </xs:element>
      <!-- 时钟分区 + 状态机（可选）。 -->
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="clock" type="esml:ClockType"/>
        <xs:element name="clocks">
          <xs:complexType><xs:sequence>
            <xs:element name="clock" type="esml:ClockType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence></xs:complexType>
        </xs:element>
        <xs:element name="stateMachine" type="esml:StateMachineType"/>
      </xs:choice>
      <xs:element name="members" minOccurs="0">
        <xs:complexType><xs:sequence>
          <!-- 复合成员一律 `<instance>`（规范 §2 收紧词法）；legacy `<component>`
               元素不在此声明。 -->
          <xs:element name="instance" type="esml:InstRefType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="connections" minOccurs="0">
        <xs:complexType><xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="connection" type="esml:ConnectType" minOccurs="0" maxOccurs="unbounded"/>
          <!-- 连接级 <for var in=…> 循环（规范 §7） -->
          <xs:element name="for" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:choice></xs:complexType>
      </xs:element>
      <xs:element name="methods" type="esml:MethodsType" minOccurs="0"/>
    
      <!-- 严格层此前未声明/顺序敏感；xs:anyType 占位，待细化 -->
      <xs:element name="discrete" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="events" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <!-- `<elsewhen>` 与 `<when>` 平级（`WhenType` 自身另可嵌套 elsewhen，
               那条路径用于单块内链式条件；两条路径都由 model.rs 的事件读取消费）。 -->
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="when" type="esml:WhenType"/>
            <xs:element name="elsewhen" type="esml:WhenType"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <!-- 类级继承的 canonical 拼法只有上面那个 `<extendsFrom>`（规范 §4.0）；
           同语义的 `<extends name="Base"/>` 不在此声明。 -->
      <!-- <modelType> 内的 <function> 是子系统式绑定（create/step|derivs/free），
           复用顶层 <functions> 的 FunctionType。接受两种形状
           （canonical XSD / 代码生成输出）。 -->
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="functions" minOccurs="0" maxOccurs="1">
          <xs:complexType><xs:sequence>
            <xs:element name="function" type="esml:FunctionType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence></xs:complexType>
        </xs:element>
        <xs:element name="function" type="esml:FunctionType"/>
      </xs:choice>
</xs:choice>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <!-- `domain` 是否退役留待单轨复核（SPEC L186 用 `discipline=`；引擎 XSD 亦用 `domain`）。 -->
    <xs:attribute name="domain" type="xs:string" use="optional"/>
    <xs:attribute name="discipline" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- modelType 级初值（初始猜测）：`<initial><scope><equation>…`
       —— 与 SystemType 级的 `<initial>` **不同型**：这里 `scope@instance` 可省
       （方程左端自带实例路径，如 `Outlet.F = Fguess`）。刻意不共用，以免顺手
       放宽 system 级 `instance` 必填（语义分歧见 vector-arithmetic.comp.esml）。 -->
  <xs:complexType name="ModelInitialScopeType">
    <xs:sequence>
      <xs:element name="equation" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType mixed="true">
          <xs:sequence><xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="instance" type="esml:Ident" use="optional"/>
  </xs:complexType>
  <xs:complexType name="ModelInitialType">
    <xs:sequence>
      <xs:element name="scope" type="esml:ModelInitialScopeType"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- 系统/子系统（<system> 可作 instance type= 复用） -->
  <xs:complexType name="ScopeSetType">
    <xs:sequence>
      <xs:element name="set" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="path" type="xs:string" use="required"/>
          <xs:attribute name="value" type="xs:string" use="optional"/>
          <xs:anyAttribute processContents="lax"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="instance" type="esml:Ident" use="required"/>
  </xs:complexType>
  <xs:complexType name="SystemType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <!-- L-ANNOT：图形/图标/摆位/端口落点；不进语义，求解器忽略；可多份并列 -->
      <xs:element name="annotation" type="esml:AnnotationType" minOccurs="0" maxOccurs="unbounded"/>
      <!-- 初始选择器（规范 §135 / 附录 SELECTOR）：system 级初值选择 -->
      <xs:element name="initialSelectors" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
      <!-- partition 表（稳定小 id，供 instances/links 引用）。 -->
      <xs:element name="partitions" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="partition" type="esml:PartitionType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="instances" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="instance" type="esml:InstRefType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="connections" minOccurs="0">
        <xs:complexType><xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="connection" type="esml:ConnectType" minOccurs="0" maxOccurs="unbounded"/>
          <!-- 连接级 <for var in=…> 循环（规范 §7） -->
          <xs:element name="for" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:choice></xs:complexType>
      </xs:element>
      <xs:element name="links" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="crosslink" type="esml:ConnectType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <!-- 语言规范 §6.6：系统（flowsheet）级方程，引用实例量 `inst.var`
           （build 期折为 `inst__var`）。 -->
      <xs:element name="equations" minOccurs="0">
        <xs:complexType><xs:choice minOccurs="0" maxOccurs="unbounded">
          <!-- 选择器 <case>（规范附录 SELECTOR / CASE·STN） -->
          <xs:element name="case" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
          <!-- 系统级条件 <if>（语义同 modelType 级）。 -->
          <xs:element name="if" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
          <!-- 系统级 <for> 方程循环（规范附录「FOR 循环」） -->
          <xs:element name="for" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="equation" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType mixed="true">
              <xs:sequence><xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
              <xs:attribute name="description" type="xs:string" use="optional"/>
              <xs:anyAttribute processContents="lax"/>
            </xs:complexType>
          </xs:element>
        </xs:choice></xs:complexType>
      </xs:element>
      <xs:element name="sets" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="scope" type="esml:ScopeSetType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <!-- 方法表（`<methods><method name>`）；与 modelType 级共用
           `MethodsType`（条目形状 lax）。 -->
      <xs:element name="methods" type="esml:MethodsType" minOccurs="0"/>
      <xs:element name="initial" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="scope" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType><xs:sequence>
              <xs:element name="equation" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType mixed="true">
                  <xs:sequence><xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="instance" type="esml:Ident" use="required"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence></xs:complexType>
      </xs:element>
      <!-- SCHEDULE：`<schedule><sequence>` 携带一个或多个 **step**：
             * `<call method="…"/>`     — 挂到下一 segment step 上的待执行方法名。
             * `<continueFor time="…"/>` — advance the simulation clock by
                                         `time` seconds (cumulative).
                                         `solver="…"` overrides the
                                         integrator for that one segment.
             * `<continueUntil condition="…" maxTime="…"/>` — **condition**
                                         exit: run at most `maxTime` seconds
                                         and stop at the first instant
                                         `condition` holds (spec:1319). Not a
                                         `<continueFor>` spelling: `for` exits
                                         on duration, `until` on a predicate.
             * `<reset path="…" value="…"/>` — at this
                                         step's cumulative clock time, assign
                                         `path := value`。
                                         扁平化时降为 FlatEvent::Time。
                                         canonical 拼法只有 `<reset>` 一个，
                                         同语义的别名写法不在此声明。
             * `<stop time="…"/>`       — STOP。Segment totals encode
                                         the end-time; this records the STOP
                                         boundary for validation.
       -->
      <xs:element name="schedule" minOccurs="0">
        <xs:complexType><xs:sequence>
          <!-- A schedule is a `<sequence>` of step elements. -->
          <xs:element name="sequence" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType>
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="call" type="esml:ScheduleCallType"/>
                <xs:element name="continueFor" type="esml:ScheduleContinueForType"/>
                <xs:element name="continueUntil" type="esml:ScheduleContinueUntilType"/>
                <xs:element name="reset" type="esml:ScheduleResetType"/>
                <xs:element name="stop" type="esml:ScheduleStopType"/>
              </xs:choice>
            </xs:complexType>
          </xs:element>
          <!-- Legacy / vendor extensions in other namespaces: lax-process
               so a missing schema doesn't fail validation. -->
          <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="fixed" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="scope" type="esml:ScopeSetType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="free" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="scope" type="esml:ScopeSetType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType>
      </xs:element>
    
      <!-- 严格层此前未声明/顺序敏感；xs:anyType 占位，待细化 -->
      <xs:element name="extendsFrom" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="initialisationProcedures" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="connectRules" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="observe" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="presets" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
</xs:choice>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <!-- `domain` 是否退役留待单轨复核（SPEC L186 用 `discipline=`；引擎 XSD 亦用 `domain`）。 -->
    <xs:attribute name="domain" type="xs:string" use="optional"/>
    <xs:attribute name="discipline" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 库 / 场景共同根；场景里系统可直接引用经 <use> 合并的组件/类型 -->
  <xs:element name="esml">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <!-- L-ANNOT：文档级注记（图形/图标/摆位/端口落点）；不进语义 -->
        <xs:element name="annotation" type="esml:AnnotationType" minOccurs="0" maxOccurs="unbounded"/>
        <!-- 文档元数据（author/license/description）；lax 任意子结构。 -->
        <xs:element name="metadata" type="esml:MetadataType" minOccurs="0" maxOccurs="1"/>
        <xs:element name="use" type="esml:UseType" minOccurs="0" maxOccurs="unbounded"/>
        <!-- 顶层域声明。 -->
        <xs:element name="domains" type="esml:DomainsType" minOccurs="0" maxOccurs="1"/>
        <!-- 求解参数容器（不参与求解语义；内容被显式报告后跳过）。 -->
        <xs:element name="solutionParameters" type="esml:SolutionParametersType"
                    minOccurs="0" maxOccurs="1"/>
        <xs:element name="units" type="esml:UnitsLibraryType" minOccurs="0" maxOccurs="1"/>
        <!-- 顶层声明序集，供 array 下标。 -->
        <xs:element name="orderedSet" type="esml:OrderedSetType"
                    minOccurs="0" maxOccurs="unbounded"/>
        <!-- 拼写单轨：`variableTypes` 只有 camelCase 这一种名字。
             此处原先是一个包着单元素的 `<xs:choice minOccurs="0" maxOccurs="1">`，
             配注释「Case-separated names are accepted as aliases (naming migration)」。
             那段脚手架是死的：XSD 大小写敏感，`<xs:choice>` 里只有一个分支时与直接写
             元素完全等价，**它并没有、也不可能接受 `<variable-types>` 之类的别名**。
             注释却让人以为大小写别名还在 —— 同一语义两种名的错觉就是这么来的。
             故拆掉，只留元素本身。SPEC §2「canonical 唯一，不向后兼容旧写法」。 -->
        <xs:element name="variableTypes" type="esml:VariableTypesType"
                    minOccurs="0" maxOccurs="1"/>
        <!-- record-type 目录（可选）。 -->
        <xs:element name="recordTypes" minOccurs="0" maxOccurs="1">
          <xs:complexType><xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="recordType" type="esml:RecordTypeDef"/>
            </xs:choice>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="optional"/>
          <xs:anyAttribute processContents="lax"/>
          </xs:complexType>
        </xs:element>
        <!-- 同上：单分支 choice 是死脚手架，`portTypes` 只有 camelCase 一种拼写。 -->
        <xs:element name="portTypes" minOccurs="0" maxOccurs="1">
          <xs:complexType><xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="portType" type="esml:PortTypeDef"/>
            </xs:choice>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="optional"/>
          <xs:anyAttribute processContents="lax"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="functions" minOccurs="0">
          <xs:complexType><xs:sequence>
            <xs:element name="function" type="esml:FunctionType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:any namespace="##other" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
        </xs:element>
        <!-- 宿主对象（`<foreignObject name class><method name><set …>`）。 -->
        <xs:element name="foreignObjects" type="esml:ForeignObjectsType"
                    minOccurs="0" maxOccurs="1"/>
        <!-- 同上：单分支 choice 是死脚手架，`modelTypes` 只有 camelCase 一种拼写。 -->
        <xs:element name="modelTypes" minOccurs="0" maxOccurs="1">
          <xs:complexType><xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="modelType" type="esml:ModelType"/>
            </xs:choice>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="optional"/>
          <xs:anyAttribute processContents="lax"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="systems" minOccurs="0" maxOccurs="1">
          <xs:complexType><xs:sequence>
            <xs:element name="system" type="esml:SystemType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="optional"/>
          <xs:anyAttribute processContents="lax"/>
          </xs:complexType>
        </xs:element>
        <xs:element ref="esml:computeTasks" minOccurs="0" maxOccurs="1"/>
        <!-- 旧 `<tasks>` 外层壳（规范 §6.8）已废弃：canonical-strict（2026-11）
             起 parser F1 响亮拒收，compute.xsd 的全局元素已移除。 -->
      </xs:choice>
      <xs:attribute name="name" type="xs:string" use="optional"/>
      <xs:attribute name="schema" type="xs:string" use="optional"/>
      <xs:attribute name="coordinate" type="xs:string" use="optional"/>
      <xs:attribute name="version" type="xs:string" use="optional"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <!-- 独立库文件根（units / variable-types / model-types）可直接作根 -->
  <xs:element name="units" type="esml:UnitsLibraryType"/>
  <xs:element name="variableTypes" type="esml:VariableTypesType"/>
  <xs:element name="systems">
    <xs:complexType><xs:sequence>
      <xs:element name="system" type="esml:SystemType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="optional"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <!-- 独立根 `<portTypes>`。 -->
  <xs:element name="portTypes">
    <xs:complexType><xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="portType" type="esml:PortTypeDef"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <!-- 独立根 `<system>`（部分文件以 system 作根；合法）。 -->
  <xs:element name="system" type="esml:SystemType"/>

  <!-- 序集独立根。只有单数 `<orderedSet>`；复数容器 `<orderedSets>` 不是
       合法语法（序集是平铺的表，没有「集合的集合」节点）。 -->
  <xs:element name="orderedSet" type="esml:OrderedSetType"/>

  <!-- 独立根 `<metadata>` 块（文档根元数据；子结构不被消费，lax 通过）。
       SPEC §1.1 点名的四个自由文本子元素 + T-DOCREF 的 `<doc>` 在此补**全局
       真声明**：库根 `<metadata>` 文档（`D-skeleton/metadata.esml` 等）里
       `<author>`/`<license>`/`<description>`/`<provenance>`/`<doc>` 走这些
       全局元素，strict 闸（撤 xs:any）下仍绿——通配只兜 SPEC 未点名的
       自由键值（条文要求放行任意子元素，见 MetadataType 注释）。 -->
  <xs:element name="metadata" type="esml:MetadataType"/>
  <xs:element name="author" type="esml:MetadataFreeTextType"/>
  <xs:element name="license" type="esml:MetadataFreeTextType"/>
  <xs:element name="description" type="esml:MetadataFreeTextType"/>
  <xs:element name="provenance" type="esml:MetadataFreeTextType"/>
  <xs:element name="doc" type="esml:DocRefType"/>
  <xs:element name="modelTypes">
    <xs:complexType><xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="modelType" type="esml:ModelType"/>
      </xs:choice>
    </xs:sequence></xs:complexType>
  </xs:element>

  <!-- ======================================================================
       §14 外部函数（extern，C ABI）
       `<function kind="external">` + `<extern>` + 三档导数契约。
       纯表达式函数用 `<body>`（mixed：文本表达式或 `<equation>`）。
       ====================================================================== -->
  <xs:simpleType name="FunctionKindType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pure"/>
      <xs:enumeration value="external"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="FfiKindType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="c"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DerivativeModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="analytic"/>
      <xs:enumeration value="fd"/>
      <xs:enumeration value="opaque"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="FunctionInputType">
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="type" type="xs:string" use="optional"/>
    <xs:attribute name="unit" type="esml:UnitExpressionType" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- 函数局部量（SPEC 附录 I）：`<locals><local name="t"/></locals>`，
       只有 `name=`；声明性元数据，进 `<algorithm>` 体内内联展开。 -->
  <xs:complexType name="FunctionLocalType">
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- 算法段 / 过程体 / 事件动作共用一条寻址：`path=` 或 `name=` 二选一
       required（XSD 1.0 表达不了跨属性互斥，用 pattern 封死「两者皆无」与
       「同义两拼」；两者俱有时响亮放行，语义优先级由解析层裁决）。
       三处语料形状：
         * 事件动作（附录 F3 / §96）：`<assign path="on" value="1.0"/>`
           —— 离散状态置值，**无 name 属性**。
         * 函数算法段（附录 I）：`<assign name="t" value="…"/>` —— 对函数
           局部量赋值，**无 path 属性**（`L8-function/locals.esml`）。
         * 初始化过程（§6.7）：`<start>` 内 `<set>` / `<assign>` 寻址用 `path=`，
           与上列事件动作同形（`L2-discrete/initialisationprocedures.esml`）。
       统一 `xs:string` 类型：`value` 是表达式文本，`unit` 复用既有单位类型。 -->
  <xs:simpleType name="AddressPatternType">
    <xs:restriction base="xs:string">
      <xs:pattern value=".*[a-zA-Z].*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="AssignType">
    <xs:attribute name="name" type="esml:Ident" use="optional"/>
    <xs:attribute name="path" type="esml:AddressPatternType" use="optional"/>
    <xs:attribute name="value" type="xs:string" use="optional"/>
    <xs:attribute name="unit" type="esml:UnitExpressionType" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <!-- `<condition>`：条件文本容器（`<algorithm>` 内 `<if>`/`<while>` 的判据、
       `<events><when condition=>` 的同义子元素写法）。语料中为纯文本，
       与函数 `<body>` 同纪律（内容不逐句机验，响亮拒收未知子元素）。 -->
  <xs:complexType name="ConditionType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="condition" type="xs:string" use="optional"/>
        <xs:anyAttribute processContents="lax"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <!-- `<algorithm>` 语句集（附录 I + SPEC「算法段降级」段 + 附录 F3 同族）：
       `<assign>` 逐句赋值；`<if><condition>…</condition><then>…[<else>…]</then></if>`
       条件分支（降级期静态展开为 `ifelse`，故 `<then>` 至多一次、`<else>` 至多一次
       且仅在 `<then>` 内）；`<while condition="c">…</while>` 循环（**仅常量
       false** 条件可处理，运行时条件是响亮错误——循环体 schema 层不机验，
       与 `<body>` 同纪律）。语料实测：当前仅 `<assign>` 出现
       （`T-tasks/algorithm.esml`、`L8-function/locals.esml`）；`<if>` / `<for>`
       / `<return>` 为 SPEC 点名的降级对象（SPEC「算法段降级为纯表达式」：
       `assign` 代入、`if/else`→`ifelse`、常量 `for` 展开），按条文封入。
       封闭 choice、未知语句自此响亮拒收——此前整段是 `mixed + xs:any skip`
       裸兜底，strict 闸下撤掉即红。 -->
  <xs:complexType name="AlgorithmType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="assign" type="esml:AssignType"/>
        <xs:element name="if">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="condition" type="esml:ConditionType"/>
              <xs:element name="then" type="esml:AlgorithmThenType" minOccurs="1" maxOccurs="1"/>
              <xs:element name="else" type="esml:AlgorithmThenType" minOccurs="0" maxOccurs="1"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="while">
          <xs:complexType>
            <xs:sequence>
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="assign" type="esml:AssignType"/>
              </xs:choice>
            </xs:sequence>
            <xs:attribute name="condition" type="xs:string" use="required"/>
            <xs:anyAttribute processContents="lax"/>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="AlgorithmThenType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="assign" type="esml:AssignType"/>
      </xs:choice>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="ExternType">
    <xs:attribute name="ffi" type="esml:FfiKindType" use="optional" default="c"/>
    <xs:attribute name="library" type="xs:string" use="required"/>
    <xs:attribute name="symbol" type="xs:string" use="required"/>
    <xs:attribute name="threadSafe" type="xs:boolean" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="DerivativeSymbolType">
    <xs:attribute name="order" type="xs:positiveInteger" use="optional" default="1"/>
    <xs:attribute name="symbol" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="WrtType">
    <xs:attribute name="wrt" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="PartialType" mixed="true">
    <xs:sequence>
      <xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="wrt" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="DerivativeType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="partial" type="esml:PartialType"/>
      <xs:element name="derivativeSymbol" type="esml:DerivativeSymbolType"/>
      <xs:element name="zeroDerivative" type="esml:WrtType"/>
      <xs:element name="noDerivative" type="esml:WrtType"/>
    </xs:choice>
    <xs:attribute name="mode" type="esml:DerivativeModeType" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="FdType">
    <xs:attribute name="step" type="xs:double" use="optional"/>
    <xs:attribute name="relative" type="xs:boolean" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="FunctionType">
    <xs:sequence>
      <xs:element name="inputs" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="input" type="esml:FunctionInputType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
      </xs:element>
      <!-- W9：`<outputs>`/`<locals>` 原来是 `xs:any processContents="skip"`
           裸兜底（strict 闸下撤掉即红，且 skip 语义本身就在假装「内容不
           校验」）。语料实测（2026-11）：`<output>` 形状 = `<output name [type=unit=]/>`，
           与 `FunctionInputType` 同形（name required，type/unit optional）；
           `<local>` 只有 `name=`（SPEC 附录 I：`<locals><local name="t"/>`）。
           按实测封死，未知子元素自此响亮拒收。 -->
      <xs:element name="outputs" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="output" type="esml:FunctionInputType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
      </xs:element>
      <xs:element name="locals" minOccurs="0">
        <xs:complexType><xs:sequence>
          <xs:element name="local" type="esml:FunctionLocalType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
      </xs:element>
      <xs:choice minOccurs="0" maxOccurs="1">
        <xs:element name="body">
          <xs:complexType mixed="true"><xs:sequence>
            <xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
        </xs:element>
        <xs:sequence>
          <xs:element name="extern" type="esml:ExternType"/>
          <xs:element name="derivative" type="esml:DerivativeType" minOccurs="0"/>
          <xs:element name="fd" type="esml:FdType" minOccurs="0"/>
        </xs:sequence>
        <xs:element name="algorithm" type="esml:AlgorithmType"/>
      </xs:choice>
      <!-- `<partials>`（函数级偏导表）与 `<body>` **可共存**
           （见 examples/syntax/L3-model/partials.esml），故不能留在上面的
           maxOccurs=1 choice 内。 -->
      <xs:element name="partials" minOccurs="0" maxOccurs="1">
        <xs:complexType><xs:sequence>
          <xs:element name="partial" type="esml:PartialType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
      </xs:element>
      <xs:any namespace="##other" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="esml:Ident" use="required"/>
    <xs:attribute name="kind" type="esml:FunctionKindType" use="optional"/>
    <xs:attribute name="returns" type="xs:string" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- ============== SCHEDULE step types ============== -->

  <!-- `<call method="…"/>` — pending call name attached to the next
       segment step. The method body lives in
       `<methods><method name>` on the same `<system>`. -->
  <xs:complexType name="ScheduleCallType">
    <xs:attribute name="method" type="esml:Ident" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- `<continueFor time="…"/>` — advance the
       simulation clock by `time` seconds. The cumulative clock is the
       sum of `time` across all `<continueFor>` steps in the sequence;
       `<reset>` / `<stop>` fire at that boundary.

       `solver="…"` names the integrator for
       **this segment only** — `tsit5` / `rodas5p` / `fbdf` / `ida` / `dfbdf`
       / `qndf` / `nonlinear` and their accepted spellings
       (`esml_engine::solver_by_name`). A name outside that vocabulary is a
       hard error at schedule-run time, not a quiet fall back to the default
       integrator, which is why the attribute is declared as a name here and
       checked against the engine's table there. -->
  <xs:complexType name="ScheduleContinueForType">
    <xs:attribute name="time" type="xs:double" use="optional" default="0"/>
    <xs:attribute name="solver" type="esml:Ident" use="optional"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- `<continueUntil condition="…" maxTime="…"/>` — a **condition**-exit
       segment: integrate at most `maxTime`
       seconds and stop at the first instant `condition` holds; the next
       segment then continues from that instant.

       Both attributes are `required` and that is the semantics, not
       strictness for its own sake:
         * `condition` — the predicate. Without it the segment has no exit
           other than the bound, i.e. it is a `<continueFor>` wearing another
           name (and the two are never rewritten into one another).
         * `maxTime` — the upper bound. Without it a condition that never
           becomes true runs forever. The bound is also the answer when the
           condition does not trip inside it: not an error.
       `condition` is author-form dotted text (`m.x < 1.0`), the same
       expression grammar the equations use. -->
  <xs:complexType name="ScheduleContinueUntilType">
    <xs:attribute name="condition" type="xs:string" use="required"/>
    <xs:attribute name="maxTime" type="xs:double" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- `<reset path="…" value="…"/>` —
       `RESET WITHIN … DO var := v`. At this step's cumulative clock time,
       assign `path := value`. Lowered to a FlatEvent with `trigger: Time
       { at }` and `actions: [(target, value, Assign)]` at flatten time.
       `path` is a dotted `inst.path[.sub]`; `value` is a literal or
       scalar expression (array literals are not accepted by `<set>`-
       like engines; use model `default=` for array values). -->
  <xs:complexType name="ScheduleResetType">
    <xs:attribute name="path" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="optional" default="0"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- `<stop time="…"/>` — STOP。The schedule's `<continueFor>`
       total already encodes the end-time; this step records the STOP
       boundary so the lowering pass can validate that no
       `<continueFor>` follows it (STOP terminates
       the sequence). -->
  <xs:complexType name="ScheduleStopType">
    <xs:attribute name="time" type="xs:double" use="optional" default="0"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
</xs:schema>
