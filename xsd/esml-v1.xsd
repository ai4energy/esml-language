<?xml version="1.0" encoding="UTF-8"?>
<!-- ESML v1 — 单一 schema。
     规范入口：校验文档为合法 ESML（namespace / 根元素 / 基本属性）。
     本 schema 不约束内部结构，需更强内容校验时用 esml-canonical-basic.xsd。

     本层是**根合法性闸**：它只回答「这份文档的根是不是合法 ESML 根」，
     内部结构一律交给 canonical 层。因此本层的**根集合必须恒等于
     canonical 层的全局元素集合**（唯一真相 = canonical XSD）：
     少一个 ⇒ 一份合法的 canonical 文档被本层判非法（假拒）；
     多一个 ⇒ 本层放行一份没有任何 canonical schema 能校验的文档（假收）。
     下方根矩阵块由 `docs/validate_roots.py` 的 sync 模式生成、逐字复核，
     **不是手抄的清单**。裁决记录：docs/design/root-matrix-adjudication.md

     ROOT-MATRIX:BEGIN
     根清单 = canonical 层的全局元素（唯一真相 = canonical XSD）。
     入口层的根集合必须与 canonical 层的全局元素集合**相等**：
     少一个 ⇒ 合法文档被入口层判非法；多一个 ⇒ 根合法性闸有洞。
     本块由 `docs/validate_roots.py` 的 sync 模式生成，**勿手工编辑**；
     `docs/validate_roots.py` 逐字复核本块（漂移即判红）。
     裁决记录：docs/design/root-matrix-adjudication.md
     根 | 入口层 | canonical 声明处 | 裁定
     computeTasks | 是 | esml-canonical-compute.xsd | —
     esml | 是 | esml-canonical-basic.xsd | —
     metadata | 是 | esml-canonical-basic.xsd | —
     modelTypes | 是 | esml-canonical-basic.xsd | —
     orderedSet | 是 | esml-canonical-basic.xsd | —
     portTypes | 是 | esml-canonical-basic.xsd | —
     project | 是 | esml-canonical-project.xsd | —
     system | 是 | esml-canonical-basic.xsd | —
     systems | 是 | esml-canonical-basic.xsd | —
     tasks | 是 | esml-canonical-compute.xsd | —
     units | 是 | esml-canonical-basic.xsd | —
     variableTypes | 是 | esml-canonical-basic.xsd | —
     ROOT-MATRIX:END
     -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:esml="https://www.ai4energy.cn/esml/v1"
           targetNamespace="https://www.ai4energy.cn/esml/v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0.0">

  <xs:element name="esml">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:any namespace="##targetNamespace" processContents="lax"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="optional"/>
      <xs:attribute name="schema" type="xs:string" use="optional"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <!-- 根清单 = canonical 层的**全局元素**（唯一真相 = XSD）：
       esml / units / variableTypes / portTypes / modelTypes / systems / system /
       orderedSet / computeTasks / tasks / metadata / project。
       逐元素对账（xsd/esml-canonical-*.xsd 的全局元素声明）：
         本层补上 metadata（basic）与 project（project）——它们在 canonical 层是
         全局元素，此前入口层没列，入口层会拒收 canonical 层认可的根。
         `<tasks>` 同理：canonical-compute.xsd 已把 §6.8 的顶层壳升为全局元素，
         入口层必须同步声明，否则入口层误拒 canonical 层认可的根。
         本层删掉 schedule / solutionParameters / variables / domain——这四个在
         canonical 层都不是全局元素（schedule 只在 <system> 内、solutionParameters
         只在 <esml> 内、variables 只在 <modelType> 内、domain 只在 <domains> 内），
         入口层却把它们当根收下，等于放行一份 canonical 层必然拒收的文档（假绿）。
       独立库文件根（units / variableTypes / systems / portTypes / system /
       orderedSet / metadata / modelTypes）与顶层壳（computeTasks / tasks /
       project）—— 名单见文件头 ROOT-MATRIX 块，由 `docs/validate_roots.py`
       的 sync 模式生成并逐字机判。 -->
  <xs:element name="units">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>
  <xs:element name="variableTypes">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>
  <xs:element name="systems">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>
  <xs:element name="portTypes">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>
  <!-- `<system>` 也可作为文档根出现（少见但合法）。 -->
  <xs:element name="system">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>
  <!-- 序集写作单数 `<orderedSet>`，复数容器 `<orderedSets>` 不是合法语法：
       序集在文档中是平铺的一层集合，不存在「集合的集合」这一层。 -->
  <xs:element name="orderedSet">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="element" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType mixed="true">
            <xs:anyAttribute processContents="lax"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="optional"/>
      <xs:attribute name="static" type="xs:string" use="optional"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>
  <!-- 独立根 `<metadata>` 块（文档根元数据；子结构不被消费，lax 通过）。 -->
  <xs:element name="metadata">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>
  <xs:element name="modelTypes">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>
  <!-- 顶层计算壳（`<computeTasks>` / `<tasks>`）：内容 lax 透传，结构由
       esml-canonical-compute.xsd 校验。 -->
  <xs:element name="computeTasks">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>
  <xs:element name="tasks">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>
  <!-- 工程壳（`<project>`）：结构由 esml-canonical-project.xsd 校验。 -->
  <xs:element name="project">
    <xs:complexType><xs:sequence><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:any namespace="##targetNamespace" processContents="lax"/></xs:choice></xs:sequence><xs:anyAttribute processContents="lax"/></xs:complexType>
  </xs:element>

</xs:schema>
