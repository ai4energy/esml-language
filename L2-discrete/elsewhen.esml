<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 `<when>` 内的 `<elsewhen condition>`：互斥分支链。解析期为同一 `<when>/<elsewhen>` 链
     分配共享互斥组（`excl_group`），同一事件时刻按声明序最多只触发首个命中的分支（对齐 Modelica
     `when ... elsewhen ...`）。规范条文：附录 F3（事件语义糖）。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L2_ElseWhen">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes><modelType name="M">
    <discrete><variable name="mode" type="real" default="0.0"/></discrete>
    <variables><variable name="x" type="real" role="state" initial="0.0"/></variables>
    <equations>
      <equation>Der(x) = mode</equation>
    </equations>
    <events>
      <when condition="time > 1.0">
        <assign path="mode" value="1.0"/>
        <elsewhen condition="time > 2.0">
          <assign path="mode" value="2.0"/>
        </elsewhen>
      </when>
    </events>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="M"/></instances>
    <schedule><sequence><continueFor time="3"/></sequence></schedule>
  </system></systems>
</esml>
