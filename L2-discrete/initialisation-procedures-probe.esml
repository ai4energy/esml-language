<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 负例（预期失败）：初始化过程表容器用 `<initialisation-procedures>`
     （kebab-case）形态。legacy 拼法，XSD 拒收（`<system>` 只声明 camelCase
     `<initialisationProcedures>`）；canonical 用 `<initialisationProcedures>`，
     见 L2-discrete/initialisationprocedures.esml 正例。非零退出是预期行为。
     规范条文：§6.7 初始化过程表（kebab 拼写一律拒收）。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L2_InitProcProbe">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <modelTypes><modelType name="M" discipline="generic">
    <variables><variable name="y" type="real" role="state" initial="0.0"/></variables>
    <equations><equation>Der(y) = 0.0</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="a" type="M"/></instances>
    <initialisation-procedures><initialisationProcedure name="p"/></initialisation-procedures>
    <schedule><sequence><continueFor time="1"/></sequence></schedule>
  </system></systems>
</esml>
