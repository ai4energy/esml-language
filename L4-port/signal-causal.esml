<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 信号口跨 PortType 的因果连接（附录 F2）：`<portType>` 的端口变量全为
     `input|output` role ⇒ 该口是**信号连接器**，可跨 PortType 连接（SigOut↔SigIn）。
     连接只许 **output↔input**；逐 pvar 命名须一致——两份 portType 的 pvar 同名 `y`。
     连接展开为该 pvar 的**逐位置相等**（不是 potential 相等 + flow 守恒那一对）。
     组件侧须显式声明 `<leaf>__<pvar>` 变量（非 autovivify）：Src 声明 `p.y`、Rec 声明 `q.y`。
     规范条文：附录 F2（信号 causal 连接护栏）。
     `check` errors=0；`solve`（system S）：s.p.y = V = 7.0 ⇒ r.q.y = 7.0（相等约束）。
     ⚠ 实现侧目前**没有护栏**：`signal_causal_guard` 未实现——input↔input（无驱动源）、
     output↔output（双驱动）、pvar 命名不一致这三种写法，现实现一律**放行**
     （`check` rc=0）——属规范↔实现缺口，见 `docs/coverage.md`。
     本件只演示合法的那一侧；护栏侧目前没有可机验的样例，故不另立文件。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L4_SignalCausal">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <portTypes>
    <portType name="SigOut" connectorFamily="signal">
      <portVariable name="y" causality="output" type="real"/>
    </portType>
    <portType name="SigIn" connectorFamily="signal">
      <portVariable name="y" causality="input" type="real"/>
    </portType>
  </portTypes>
  <modelTypes>
    <modelType name="Src">
      <ports><port name="p" portType="SigOut"/></ports>
      <parameters><parameter name="V" type="real" default="7.0"/></parameters>
      <variables><variable name="p.y" type="real" role="algebraic"/></variables>
      <equations><equation>p.y = V</equation></equations>
    </modelType>
    <modelType name="Rec">
      <ports><port name="q" portType="SigIn"/></ports>
      <variables><variable name="q.y" type="real" role="algebraic"/></variables>
    </modelType>
  </modelTypes>
  <systems><system name="S" discipline="signal">
    <instances><instance name="s" type="Src"/><instance name="r" type="Rec"/></instances>
    <connections><connection from="s.p" to="r.q"/></connections>
    <schedule><sequence><continueFor time="0"/></sequence></schedule>
  </system></systems>
</esml>
