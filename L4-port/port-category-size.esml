<!-- 语法点 端口实例的 category 与 size 属性：category=inlet/outlet/bi 标端口方向，size=1 标端口束规模。
     本例 HeatPort 的两个端口分别标 inlet 与 outlet，size=1。
     规范条文：§5（端口）。
     check errors=0。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L4_PortCatSize">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <portTypes><portType name="HeatPort" connectorFamily="thermal">
    <variables>
      <portVariable name="T" portRole="potential" type="real"/>
      <portVariable name="Q_flow" portRole="flow" type="real"/>
    </variables>
  </portType></portTypes>
  <modelTypes><modelType name="FixedT">
    <ports>
      <port name="port_a" portType="HeatPort" category="inlet" size="1"/>
      <port name="port_b" portType="HeatPort" category="outlet" size="1"/>
    </ports>
    <parameters><parameter name="Tset" type="real" default="300.0"/></parameters>
    <variables>
      <variable name="port_a.T" type="real" role="algebraic"/>
      <variable name="port_a.Q_flow" type="real" role="algebraic"/>
      <variable name="port_b.T" type="real" role="algebraic"/>
      <variable name="port_b.Q_flow" type="real" role="algebraic"/>
    </variables>
    <equations><equation>port_a.T = Tset</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="f" type="FixedT"/></instances>
    <schedule><sequence><continueFor time="1"/></sequence></schedule>
  </system></systems>
</esml>
