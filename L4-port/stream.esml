<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 ① 端口变量 `portRole="stream"` 的 canonical 形态：
     `<portVariable name type portRole="stream"/>`。旧的元素形态 `<stream name type/>`
     已退役（解析期响亮拒收），本例用 canonical 形态：Mix 进出组分直通 out.c = in.c。
     语法点 ② 端口 `portSet`（参数沿流股传播）：`<port … portSet="flow"/>`——
     同模型同 portSet 参数等值；本例 in/out 两个 StreamPort 实例同属 `flow` 集，
     即该 Mix 上沿 stream 流股传播的参数在这对端口间等值。
     规范条文：① 附录 F1（stream 流股）；② 附录 B（续）PORTSET，§2.7。
     期望（ESML_PROPS=off esml solve 实测）：m.in.c = 0.25、m.out.c = 0.25（组分直通）。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L4_PortVarStream">
  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <portTypes><portType name="StreamPort" connectorFamily="stream">
    <variables>
      <portVariable name="c" type="real" portRole="stream"/>
    </variables>
  </portType></portTypes>
  <modelTypes><modelType name="Mix">
    <ports>
      <port name="in"  portType="StreamPort" portSet="flow"/>
      <port name="out" portType="StreamPort" portSet="flow"/>
    </ports>
    <variables>
      <variable name="in.c"  type="real" role="algebraic"/>
      <variable name="out.c" type="real" role="algebraic"/>
    </variables>
    <equations>
      <equation>in.c = 0.25</equation>
      <equation>out.c = in.c</equation>
    </equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="Mix"/></instances>
  </system></systems>
</esml>
