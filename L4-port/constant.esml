<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点 portType 内的端口变量**元素**形态 `<constant name type/>`：直接挂在 `<portType>` 下，
     不经 `<variables>` 容器；元素名即 role=constant（等价 `role="constant"`，
     显式 role= 属性优先）。本例端口常量 c 由模型以 p.c = 3.0 定值，y = 2·c。
     规范条文：§5（端口）。
     `check` errors=0；`solve` y = 6.0。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L4_PortVarConstant">
  <variableTypes><type name="real" unit="1" default="0.0" role="algebraic"/></variableTypes>
  <portTypes><portType name="CPin" connectorFamily="generic">
    <constant name="c" type="real"/>
  </portType></portTypes>
  <modelTypes><modelType name="M">
    <ports><port name="p" portType="CPin"/></ports>
    <variables>
      <variable name="p.c" type="real" role="algebraic"/>
      <variable name="y" type="real" role="algebraic"/>
    </variables>
    <equations><equation>p.c = 3.0</equation><equation>y = 2 * p.c</equation></equations>
  </modelType></modelTypes>
  <systems><system name="S">
    <instances><instance name="m" type="M"/></instances>
    <schedule><sequence><continueFor time="0"/></sequence></schedule>
  </system></systems>
</esml>
