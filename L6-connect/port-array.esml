<!-- 语法点 端口数组连接：portVariable 标 array="2"，<connection> 对数组端口逐元素建相等约束（§6.4:409、§8）。
     规范条文：§6.4:409「<connection> 对数组端口逐元素建相等约束」、§8 显式域 connect 逐 pvar 相等。
     本例：Src 钉 s.p.v[1]=1.0、s.p.v[2]=2.0；Dst 纯读出口、无自身方程；连接 from="s.p" to="d.p"。
     实测（2026-11-11，ESML v1.9.3）：
       esml check → errors=0；esml solve → 4 unknowns：
         s.p.v_1=1.0  s.p.v_2=2.0  d.p.v_1=1.0  d.p.v_2=2.0（逐元素相等）
     历史：J2 前 flatten 数组臂缺 pvar 守卫（同一路径物化两次：2 段 vs 3 段 SymId），
       Pantelides 报 4 unmatched（与残差表自相矛盾）；J2 补守卫后 4 未知量恰定。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L6_PortArray">

  <variableTypes><type name="real" unit="1" default="0.0"/></variableTypes>
  <portTypes><portType name="Bus" connectorFamily="generic">
    <variables><portVariable name="v" portRole="potential" type="real" array="2"/></variables>
  </portType></portTypes>
  <modelTypes>
    <modelType name="Src">
      <ports><port name="p" portType="Bus"/></ports>
      <variables><variable name="p.v" type="real" role="algebraic" array="2"/></variables>
      <equations><equation>p.v[1] = 1.0</equation><equation>p.v[2] = 2.0</equation></equations>
    </modelType>
    <modelType name="Dst">
      <ports><port name="p" portType="Bus"/></ports>
      <variables><variable name="p.v" type="real" role="algebraic" array="2"/></variables>
    </modelType>
  </modelTypes>
  <systems><system name="S">
    <instances><instance name="s" type="Src"/><instance name="d" type="Dst"/></instances>
    <connections><connection from="s.p" to="d.p"/></connections>
  </system></systems>
</esml>
