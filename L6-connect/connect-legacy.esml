<?xml version="1.0"?>
<!-- Author: Mingtao Li <mingtao@xjtu.edu.cn> -->
<!-- SPDX-License-Identifier: MIT -->
<!-- 语法点旧拼写 `<connections><connect from="a.p" to="b.q"/></connections>`：
     端口对连的早期写法。求解前同样展开为 potential 相等 + flow 守恒。
     `<connect>` 与 `<connection>` 是同一语义的两种拼写；新文档一律写 `<connection>`。 -->
<esml xmlns="https://www.ai4energy.cn/esml/v1" schema="esml/v1" name="L6_ConnectLegacy">
  <variableTypes><type name="real" unit="1" default="0.0" role="algebraic"/></variableTypes>
  <portTypes><portType name="Pin" connectorFamily="electrical">
    <variables>
      <portVariable name="v" role="potential" type="real"/>
      <portVariable name="i" role="flow"      type="real"/>
    </variables>
  </portType></portTypes>
  <modelTypes>
    <modelType name="Src">
      <ports><port name="p" portType="Pin"/></ports>
      <parameters><parameter name="V" type="real" default="10.0"/></parameters>
      <variables><variable name="p.v" type="real" role="algebraic"/><variable name="p.i" type="real" role="algebraic"/></variables>
      <equations><equation>p.v = V</equation></equations>
    </modelType>
    <modelType name="R">
      <ports><port name="p" portType="Pin"/></ports>
      <parameters><parameter name="R" type="real" default="100.0"/></parameters>
      <variables><variable name="p.v" type="real" role="algebraic"/><variable name="p.i" type="real" role="algebraic"/></variables>
      <equations><equation>p.v = R * p.i</equation></equations>
    </modelType>
    <modelType name="Gnd">
      <ports><port name="g" portType="Pin"/></ports>
      <variables><variable name="g.v" type="real" role="algebraic"/><variable name="g.i" type="real" role="algebraic"/></variables>
      <equations><equation>g.v = 0</equation></equations>
    </modelType>
  </modelTypes>
  <systems><system name="S" discipline="electrical">
    <instances><instance name="s" type="Src"/><instance name="r" type="R"/><instance name="g" type="Gnd"/></instances>
    <connections><connect from="s.p" to="r.p"/><connect from="r.p" to="g.g"/></connections>
  </system></systems>
</esml>
